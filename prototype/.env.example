# Копировать в .env и заполнить. Реальный .env — в .gitignore, не коммитить.
# Откуда взять каждое значение — docs/11_live_demo_architecture.md, ручной чек-лист.

CLICKUP_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=
CLICKUP_WEBHOOK_SECRET=
BOT_USER_ID=

# Qwen (Alibaba, OpenAI-совместимый эндпоинт) — LLM для классификации комментариев
# (inbound/comment_router.py) и генерации ответов агента (agents/live_demo_agent.py).
# QWEN_BASE_URL/QWEN_MODEL опциональны — дефолты в core/llm.py, переопределять
# только если у вас другой workspace-эндпоинт Model Studio.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Держать выключенным на день звонка (см. docs/11_live_demo_architecture.md
# про риск рассинхрона secret'а на временном ngrok-стенде).
REQUIRE_WEBHOOK_SIGNATURE=false
